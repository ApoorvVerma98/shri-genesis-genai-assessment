# # AI provider: openai-compatible | ollama | fallback
# AI_PROVIDER=fallback

# # OpenAI-compatible (Groq free tier — no card; create key at console.groq.com/keys)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=
# AI_MODEL=openai/gpt-oss-20b

# # When AI is configured but fails: fallback (default) or hard-fail
# AI_ALLOW_FALLBACK=true
# AI_STRICT=false

# Optional delay between AI calls during batch (ms) to reduce Groq 429 rate limits
AI_BATCH_DELAY_MS=3000

# Retries for retryable AI HTTP errors (429/502/503); honors Retry-After when present
# AI_MAX_RETRIES=4
# AI_RETRY_BASE_MS=1000
# AI_RETRY_MAX_MS=60000

# # Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# # Generation
# Relative to monorepo root (not apps/api cwd)
# OUTPUT_DIR=outputs
# BATCH_SIZE=100
# API_PORT=3001
